# Copie para ".env" e preencha. NUNCA commite o ".env" (já está no .gitignore).

# Banco. Padrão: SQLite local em dev. Em produção, Postgres:
# DATABASE_URL=postgresql+psycopg2://usuario:senha@host:5432/homeclue
DATABASE_URL=sqlite:///./homeclue.db

# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=troque-esta-chave-antes-de-ir-para-producao
JWT_EXPIRA_MINUTOS=720

# URL pública do app — usada no snippet do widget, nos retornos do Stripe e no User-Agent.
URL_PUBLICA=http://localhost:8000
AMBIENTE=desenvolvimento

# E-mails (separados por vírgula) com acesso a /admin.html (custo de IA, clientes).
ADMIN_EMAILS=

# IA (Claude). Sem a chave, a busca usa o motor de regras — tudo continua funcionando.
ANTHROPIC_API_KEY=
# Modelo: troque e compare o custo por busca em /admin.html (ex.: claude-haiku-5-5 é ~40x mais barato).
ANTHROPIC_MODELO=claude-opus-5-5

# Preços exibidos dos planos (R$/mês) — "a definir" no documento de produto.
PRECO_PLANO_ESSENCIAL=297
PRECO_PLANO_PROFISSIONAL=497
PRECO_PLANO_PREMIUM=997

# Stripe (opcional). Sem ele, os planos aparecem mas a troca é manual.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRECO_ESSENCIAL=
STRIPE_PRECO_PROFISSIONAL=
STRIPE_PRECO_PREMIUM=
# Cobrança por lead entregue (preço "metered" ligado a um Meter com este nome de evento).
STRIPE_PRECO_POR_LEAD=
STRIPE_EVENTO_LEAD=homeclue_lead
# Maquete 3D avulsa (pagamento único por imóvel).
STRIPE_PRECO_MAQUETE=

# Fila de tarefas (feed a cada N horas, contexto do bairro, análise de fotos).
TAREFAS_EM_SEGUNDO_PLANO=true
FEED_INTERVALO_HORAS=6
