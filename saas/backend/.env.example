# Copie para ".env" e preencha. NUNCA commite o ".env" (já está no .gitignore).

# Banco. Padrão: SQLite local em dev. Em produção, Postgres:
# DATABASE_URL=postgresql+psycopg2://usuario:senha@host:5432/kaza_pro
DATABASE_URL=sqlite:///./kaza_pro.db

# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=troque-esta-chave-antes-de-ir-para-producao
JWT_EXPIRA_MINUTOS=720

# URL pública do app — usada no snippet do widget e nos retornos do Stripe.
URL_PUBLICA=http://localhost:8000

AMBIENTE=desenvolvimento

# Opcional. Sem ela, a busca usa o motor de regras e a descrição de
# anúncio usa um modelo pronto — tudo continua funcionando.
ANTHROPIC_API_KEY=

# Opcional. Sem elas, o painel mostra os planos mas não cobra online.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRECO_PRO=
STRIPE_PRECO_ESCALA=
