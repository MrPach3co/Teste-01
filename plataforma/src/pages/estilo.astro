---
// Guia de estilo interno (não aparece no Google nem no sitemap).
// Serve para conferir cores, tipografia e componentes num lugar só.
import Base from "../layouts/Base.astro";
import ImagemPlaceholder from "../components/ImagemPlaceholder.astro";
import { marca } from "../lib/conteudo";

const nomesCores: Record<string, string> = {
  fundo: "Papel", fundo_alt: "Linho", texto: "Grafite", texto_suave: "Pedra",
  primaria: "Floresta", acento: "Páprica", destaque: "Açafrão", linha: "Areia",
};
---
<Base titulo="Guia de estilo" semIndexar>
  <section class="secao">
    <div class="container">
      <div class="cabecalho-secao" data-revelar>
        <span class="sobretitulo">Etapa 1 · Identidade</span>
        <h1>Guia de <em>estilo</em></h1>
        <p class="lead">Página interna para revisar a identidade visual. Tudo aqui vem de
          <code>conteudo/marca.yaml</code>: troque um valor lá e o site inteiro acompanha.</p>
      </div>

      <h2 class="titulo-bloco">Cores</h2>
      <div class="cores">
        {Object.entries(marca.cores).map(([chave, valor], i) => (
          <div class="cor" data-revelar style={`--atraso:${i * 50}ms`}>
            <div class="cor__amostra" style={`background:${valor}`}></div>
            <strong>{nomesCores[chave] ?? chave}</strong>
            <span>{chave} · {valor}</span>
          </div>
        ))}
      </div>

      <hr class="divisoria" />

      <h2 class="titulo-bloco">Tipografia</h2>
      <div class="grade grade--2 tipos">
        <div data-revelar>
          <span class="sobretitulo">Títulos · Fraunces</span>
          <p class="amostra-titulo">Refeições saudáveis e <em>gostosas</em>, sem complicação.</p>
        </div>
        <div data-revelar style="--atraso:100ms">
          <span class="sobretitulo">Texto · Instrument Sans</span>
          <p class="lead">Cada receita é criada e testada pelo chef e tem a informação nutricional
            revisada pela nutricionista. Você cozinha com segurança e sem monotonia.</p>
          <p>Texto corrido em tamanho base, com bastante respiro entre as linhas para leitura
            confortável no celular.</p>
        </div>
      </div>
      <div class="escala">
        <h1>Título 1</h1>
        <h2>Título 2 com <em>destaque</em></h2>
        <h3>Título 3</h3>
        <h4>Título 4</h4>
      </div>

      <hr class="divisoria" />

      <h2 class="titulo-bloco">Botões e selos</h2>
      <div class="linha-componentes">
        <a href="#" class="btn">Botão principal <span class="seta" aria-hidden="true">→</span></a>
        <a href="#" class="btn btn--acento">Quero a amostra grátis</a>
        <a href="#" class="btn btn--contorno">Ver receitas</a>
        <span class="btn" aria-disabled="true">Pré-venda em breve</span>
      </div>
      <div class="linha-componentes">
        <span class="selo">20 min</span>
        <span class="selo selo--acento">Ganho de massa</span>
        <span class="selo selo--exemplo">Exemplo</span>
      </div>

      <hr class="divisoria" />

      <h2 class="titulo-bloco">Imagens provisórias</h2>
      <p class="lead">Enquanto não houver fotos reais, usamos placeholders que dizem claramente
        que são ilustrativos, em vez de imagens geradas por IA.</p>
      <div class="grade grade--3">
        <ImagemPlaceholder rotulo="Bowl de grão-de-bico" />
        <ImagemPlaceholder rotulo="Frango ao limão" tom="pimenta" />
        <ImagemPlaceholder rotulo="Overnight oats" tom="acafrao" />
      </div>
    </div>
  </section>

  <section class="secao secao--escura">
    <div class="container cabecalho-secao--centro" style="max-width:44rem">
      <span class="sobretitulo">Seção escura</span>
      <h2>Comida de verdade, com <em>método</em>.</h2>
      <p class="lead">Exemplo de faixa de chamada usada antes do rodapé.</p>
      <div class="linha-componentes" style="justify-content:center">
        <a href="#" class="btn btn--claro">Garantir na pré-venda</a>
        <a href="#" class="btn btn--contorno">Baixar amostra</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .titulo-bloco { font-size: var(--t-xl); margin-bottom: var(--e-6); }
  code { font-size: 0.9em; background: var(--cor-fundo-alt); padding: 0.1em 0.4em; border-radius: 6px; }

  .cores { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--e-5); }
  @media (min-width: 720px) { .cores { grid-template-columns: repeat(4, 1fr); } }
  .cor { display: grid; gap: var(--e-1); font-size: var(--t-sm); }
  .cor span { color: var(--cor-texto-suave); font-size: var(--t-xs); }
  .cor__amostra {
    aspect-ratio: 4 / 3; border-radius: var(--raio); margin-bottom: var(--e-2);
    box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.06);
  }

  .amostra-titulo { font-family: var(--fonte-titulo); font-size: var(--t-2xl); line-height: 1.1; }
  .amostra-titulo em { color: var(--cor-acento); }
  .escala { margin-top: var(--e-7); }
  .escala > * { margin-bottom: var(--e-3); }

  .linha-componentes { display: flex; flex-wrap: wrap; gap: var(--e-3); margin-bottom: var(--e-5); align-items: center; }
</style>
