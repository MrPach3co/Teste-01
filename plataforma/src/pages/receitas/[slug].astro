---
import Base from "../../layouts/Base.astro";
import Foto from "../../components/Foto.astro";
import Icone from "../../components/Icone.astro";
import CartaoReceita from "../../components/CartaoReceita.astro";
import BlocoNutricional from "../../components/BlocoNutricional.astro";
import AdicionarAoPlano from "../../ilhas/AdicionarAoPlano";
import { urlDaFoto } from "../../lib/imagens";
import { receitas, marca, custoPorPorcao, faixaDaReceita, type Receita } from "../../lib/conteudo";
import { REFEICOES, OBJETIVOS, DIFICULDADES, formatarMoeda, formatarQuantidade, formatarTempo } from "../../lib/comum.mjs";

export function getStaticPaths() {
  return receitas.map((receita) => ({ params: { slug: receita.slug }, props: { receita } }));
}

const { receita: r } = Astro.props as { receita: Receita };
const faixa = faixaDaReceita(r);
const rotuloRefeicao = (x: string) => REFEICOES[x as keyof typeof REFEICOES];
const rotuloObjetivo = (x: string) => OBJETIVOS[x as keyof typeof OBJETIVOS];

// Ingredientes agrupados (ex.: "Molho", "Para montar"), mantendo a ordem do arquivo
const grupos: { nome: string; itens: Receita["ingredientes"] }[] = [];
for (const ing of r.ingredientes) {
  const g = grupos.find((x) => x.nome === ing.grupo) ?? (grupos.push({ nome: ing.grupo, itens: [] }), grupos.at(-1)!);
  g.itens.push(ing);
}

// Relacionadas: mesma refeição ou objetivo, as mais parecidas primeiro
const relacionadas = receitas
  .filter((x) => x.slug !== r.slug)
  .map((x) => ({
    x,
    pontos: x.refeicoes.filter((m) => r.refeicoes.includes(m)).length * 2 + x.objetivos.filter((o) => r.objetivos.includes(o)).length,
  }))
  .sort((a, b) => b.pontos - a.pontos)
  .slice(0, 3)
  .map(({ x }) => x);

const imagemSocial = await urlDaFoto(r.foto);
// Duração no formato ISO 8601 exigido pelo Google (ex.: 90 min → "PT1H30M")
function iso(min: number) {
  const h = Math.floor(min / 60);
  const m = min % 60;
  return "PT" + (h ? h + "H" : "") + (m ? m + "M" : "");
}
function linhaIngrediente(i: Receita["ingredientes"][number]) {
  if (i.unidade === "a-gosto") return i.nome + " a gosto";
  return formatarQuantidade(i.quantidade, i.unidade) + " de " + i.nome;
}

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Recipe",
  name: r.titulo,
  description: r.resumo,
  ...(imagemSocial ? { image: [new URL(imagemSocial, marca.url_site).href] } : {}),
  author: { "@type": "Organization", name: marca.nome, url: marca.url_site },
  prepTime: iso(r.tempo_ativo_min ?? r.tempo_preparo_min),
  totalTime: iso(r.tempo_preparo_min),
  recipeYield: `${r.porcoes} porções`,
  recipeCategory: r.refeicoes.map(rotuloRefeicao).join(", "),
  recipeCuisine: "Brasileira",
  keywords: [...r.objetivos.map(rotuloObjetivo), ...r.tags].join(", "),
  recipeIngredient: r.ingredientes.map(linhaIngrediente),
  recipeInstructions: r.preparo.map((texto, i) => ({ "@type": "HowToStep", position: i + 1, text: texto })),
  nutrition: {
    "@type": "NutritionInformation",
    servingSize: r.nutricao.porcao,
    calories: `${r.nutricao.calorias_kcal} kcal`,
    proteinContent: `${r.nutricao.proteinas_g} g`,
    carbohydrateContent: `${r.nutricao.carboidratos_g} g`,
    fatContent: `${r.nutricao.gorduras_g} g`,
    fiberContent: `${r.nutricao.fibras_g} g`,
    sodiumContent: `${r.nutricao.sodio_mg} mg`,
  },
};
---
<Base titulo={r.titulo} descricao={r.resumo} jsonLd={jsonLd} imagem={imagemSocial}>
  <article class="receita">
    <div class="container">
      <nav class="trilha" aria-label="Você está em">
        <a href="/receitas">Receitas</a> <span aria-hidden="true">/</span> <span aria-current="page">{r.titulo}</span>
      </nav>

      <header class="receita__topo">
        <div class="receita__foto" data-revelar>
          <Foto caminho={r.foto} alt={r.titulo} proporcao="4/3" prioridade larguras={[600, 900, 1300]}
            sizes="(min-width: 1024px) 640px, 100vw" rotuloPlaceholder={r.titulo} />
        </div>

        <div class="receita__intro" data-revelar style="--atraso:100ms">
          <div class="receita__selos">
            {r.exemplo && <span class="selo selo--exemplo">Exemplo</span>}
            <span class="sobretitulo receita__refeicao">{r.refeicoes.map(rotuloRefeicao).join(" · ")}</span>
          </div>
          <h1>{r.titulo}</h1>
          <p class="lead">{r.resumo}</p>

          <dl class="ficha">
            <div><dt><Icone nome="relogio" tamanho={18} />Tempo total</dt><dd>{formatarTempo(r.tempo_preparo_min)}</dd></div>
            {r.tempo_ativo_min && <div><dt><Icone nome="fogo" tamanho={18} />Mão na massa</dt><dd>{formatarTempo(r.tempo_ativo_min)}</dd></div>}
            <div><dt><Icone nome="porcao" tamanho={18} />Rende</dt><dd>{r.porcoes} {r.porcoes > 1 ? "porções" : "porção"}</dd></div>
            <div><dt><Icone nome="moeda" tamanho={18} />Custo por porção</dt><dd>{formatarMoeda(custoPorPorcao(r))} <small>{faixa.simbolo}</small></dd></div>
            <div><dt><Icone nome="chef" tamanho={18} />Dificuldade</dt><dd>{DIFICULDADES[r.dificuldade as keyof typeof DIFICULDADES]}</dd></div>
          </dl>

          <ul class="receita__objetivos" aria-label="Objetivos">
            {r.objetivos.map((o) => <li><a class="selo" href={`/receitas?objetivo=${o}`}>{rotuloObjetivo(o)}</a></li>)}
          </ul>

          <div class="receita__acoes">
            <AdicionarAoPlano client:visible receita={r.slug} titulo={r.titulo} refeicoes={r.refeicoes} />
            <button type="button" class="btn btn--contorno" data-imprimir><Icone nome="imprimir" tamanho={18} /> Imprimir</button>
          </div>
        </div>
      </header>

      <div class="receita__corpo">
        <aside class="ingredientes" aria-labelledby="titulo-ingredientes">
          <div class="ingredientes__topo">
            <h2 id="titulo-ingredientes">Ingredientes</h2>
            <div class="porcoes" data-porcoes data-base={r.porcoes}>
              <button type="button" data-menos aria-label="Diminuir porções"><Icone nome="menos" tamanho={16} /></button>
              <output aria-live="polite"><span data-valor>{r.porcoes}</span> porções</output>
              <button type="button" data-mais aria-label="Aumentar porções"><Icone nome="mais" tamanho={16} /></button>
            </div>
          </div>
          {grupos.map((g) => (
            <div class="ingredientes__grupo">
              {g.nome && <h3>{g.nome}</h3>}
              <ul>
                {g.itens.map((i) => (
                  <li>
                    <label>
                      <input type="checkbox" />
                      <span class="ingrediente__qtd" data-qtd={i.quantidade ?? ""} data-unidade={i.unidade}>
                        {formatarQuantidade(i.quantidade, i.unidade)}
                      </span>
                      <span class="ingrediente__nome">{i.nome}{i.nota && <small>{i.nota}</small>}</span>
                    </label>
                  </li>
                ))}
              </ul>
            </div>
          ))}
          <p class="ingredientes__custo">
            Custo estimado da receita: <strong data-custo-total data-base={r.custo_total_estimado}>{formatarMoeda(r.custo_total_estimado)}</strong>.
            <br /><small>{marca.custo.referencia}</small>
          </p>
        </aside>

        <div class="preparo">
          <section aria-labelledby="titulo-preparo">
            <h2 id="titulo-preparo">Modo de preparo</h2>
            <ol class="passos-preparo">
              {r.preparo.map((p) => <li><p>{p}</p></li>)}
            </ol>
          </section>

          {r.dicas.length > 0 && (
            <section class="caixa caixa--dica">
              <h2><Icone nome="chef" /> Dicas do chef</h2>
              <ul>{r.dicas.map((d) => <li>{d}</li>)}</ul>
            </section>
          )}
          {r.substituicoes.length > 0 && (
            <section class="caixa">
              <h2>Substituições</h2>
              <ul>{r.substituicoes.map((d) => <li>{d}</li>)}</ul>
            </section>
          )}
          {r.conservacao && (
            <section class="caixa">
              <h2>Conservação</h2>
              <p>{r.conservacao}</p>
            </section>
          )}

          <BlocoNutricional receita={r} />
        </div>
      </div>
    </div>
  </article>

  {relacionadas.length > 0 && (
    <section class="secao secao--alt relacionadas">
      <div class="container">
        <div class="cabecalho-secao" data-revelar>
          <span class="sobretitulo">Combina com a sua semana</span>
          <h2>Outras <em>receitas</em></h2>
        </div>
        <div class="grade grade--3">
          {relacionadas.map((x, i) => <CartaoReceita receita={x} indice={i} />)}
        </div>
      </div>
    </section>
  )}
</Base>

<script>
  import { formatarQuantidade, formatarMoeda } from "../../lib/comum.mjs";

  const caixa = document.querySelector<HTMLElement>("[data-porcoes]");
  if (caixa) {
    const base = Number(caixa.dataset.base);
    let atual = base;
    const valor = caixa.querySelector("[data-valor]")!;
    const custo = document.querySelector<HTMLElement>("[data-custo-total]")!;
    const qtds = document.querySelectorAll<HTMLElement>("[data-qtd]");

    const atualizar = () => {
      valor.textContent = String(atual);
      const fator = atual / base;
      qtds.forEach((el) => {
        const q = el.dataset.qtd ? Number(el.dataset.qtd) * fator : null;
        el.textContent = formatarQuantidade(q, el.dataset.unidade);
      });
      custo.textContent = formatarMoeda(Number(custo.dataset.base) * fator);
    };
    caixa.querySelector("[data-menos]")!.addEventListener("click", () => { if (atual > 1) { atual--; atualizar(); } });
    caixa.querySelector("[data-mais]")!.addEventListener("click", () => { if (atual < 20) { atual++; atualizar(); } });
  }

  document.querySelector("[data-imprimir]")?.addEventListener("click", () => window.print());
</script>

<style>
  .receita { padding-block: var(--e-5) var(--e-secao); }
  .trilha { font-size: var(--t-sm); color: var(--cor-texto-suave); margin-bottom: var(--e-5); }
  .trilha a { color: inherit; }
  .trilha span[aria-current] { color: var(--cor-texto); }

  .receita__topo { display: grid; gap: var(--e-6); margin-bottom: var(--e-8); }
  @media (min-width: 1024px) { .receita__topo { grid-template-columns: 1.1fr 1fr; gap: var(--e-7); align-items: center; } }
  .receita__selos { display: flex; flex-wrap: wrap; align-items: center; gap: var(--e-3); margin-bottom: var(--e-3); }
  .receita__refeicao { margin: 0; }
  .receita h1 { font-size: var(--t-2xl); }

  .ficha {
    display: grid; grid-template-columns: repeat(2, 1fr); gap: 1px; margin: var(--e-5) 0;
    background: var(--cor-linha); border: 1px solid var(--cor-linha); border-radius: var(--raio); overflow: hidden;
  }
  .ficha div:last-child:nth-child(odd) { grid-column: span 2; }
  @media (min-width: 560px) {
    .ficha { grid-template-columns: repeat(3, 1fr); }
    .ficha div:last-child:nth-child(odd) { grid-column: auto; }
    .ficha div:last-child:nth-child(3n+2) { grid-column: span 2; }
  }
  .ficha div { background: var(--cor-fundo); padding: var(--e-3) var(--e-4); }
  .ficha dt { display: flex; align-items: center; gap: 0.4em; font-size: var(--t-xs); color: var(--cor-texto-suave); }
  .ficha dt :global(.icone) { color: var(--cor-acento); }
  .ficha dd { margin: var(--e-1) 0 0; font-family: var(--fonte-titulo); font-size: var(--t-lg); }
  .ficha small { font-family: var(--fonte-texto); font-size: var(--t-xs); color: var(--cor-texto-suave); letter-spacing: 0.08em; }

  .receita__objetivos { list-style: none; padding: 0; margin: 0 0 var(--e-5); display: flex; flex-wrap: wrap; gap: var(--e-2); }
  .receita__objetivos a { text-decoration: none; }
  .receita__acoes { display: flex; flex-wrap: wrap; gap: var(--e-3); align-items: flex-start; }

  .receita__corpo { display: grid; gap: var(--e-7); }
  @media (min-width: 1024px) { .receita__corpo { grid-template-columns: 380px 1fr; gap: var(--e-8); align-items: start; } }

  .ingredientes { padding: var(--e-5); border-radius: var(--raio-lg); background: var(--cor-fundo-alt); }
  @media (min-width: 1024px) { .ingredientes { position: sticky; top: 6rem; } }
  .ingredientes__topo { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: var(--e-3); margin-bottom: var(--e-4); }
  .ingredientes h2 { font-size: var(--t-xl); margin: 0; }
  .ingredientes h3 { font-family: var(--fonte-texto); font-size: var(--t-xs); font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--cor-acento); margin: var(--e-5) 0 var(--e-2); }
  .ingredientes ul { list-style: none; padding: 0; margin: 0; }
  .ingredientes li { border-bottom: 1px solid var(--cor-linha); }
  .ingredientes label { display: grid; grid-template-columns: auto 6.5rem 1fr; gap: var(--e-3); align-items: baseline; padding: var(--e-3) 0; cursor: pointer; font-size: var(--t-sm); }
  .ingredientes input { accent-color: var(--cor-primaria); width: 1rem; height: 1rem; transform: translateY(2px); }
  .ingredientes input:checked ~ span { opacity: 0.45; text-decoration: line-through; }
  .ingrediente__qtd { font-weight: 600; font-variant-numeric: tabular-nums; }
  .ingrediente__nome small { display: block; color: var(--cor-texto-suave); font-size: var(--t-xs); }
  .ingredientes__custo { margin: var(--e-5) 0 0; font-size: var(--t-sm); }
  .ingredientes__custo small { color: var(--cor-texto-suave); font-size: var(--t-xs); }

  .porcoes { display: inline-flex; align-items: center; gap: var(--e-2); padding: 0.2rem; border-radius: 999px; background: var(--cor-fundo); border: 1px solid var(--cor-linha); }
  .porcoes button { display: grid; place-items: center; width: 2.25rem; height: 2.25rem; border-radius: 50%; border: 0; background: var(--cor-fundo-alt); color: var(--cor-texto); cursor: pointer; }
  .porcoes button:hover { background: var(--cor-primaria); color: var(--cor-fundo); }
  .porcoes output { font-size: var(--t-sm); font-weight: 600; min-width: 5.5rem; text-align: center; }

  .preparo { display: grid; gap: var(--e-6); }
  .preparo h2 { font-size: var(--t-xl); }
  .passos-preparo { list-style: none; padding: 0; margin: 0; counter-reset: passo; }
  .passos-preparo li { counter-increment: passo; display: grid; grid-template-columns: 3rem 1fr; gap: var(--e-4); padding: var(--e-5) 0; border-top: 1px solid var(--cor-linha); }
  .passos-preparo li::before { content: counter(passo, decimal-leading-zero); font-family: var(--fonte-titulo); font-size: var(--t-xl); line-height: 1; color: var(--cor-acento); }
  .passos-preparo p { margin: 0; font-size: var(--t-base); }

  .caixa { padding: var(--e-5); border-radius: var(--raio-lg); border: 1px solid var(--cor-linha); }
  .caixa h2 { display: flex; align-items: center; gap: var(--e-2); font-size: var(--t-lg); margin-bottom: var(--e-3); }
  .caixa ul { margin: 0; padding-left: 1.1em; display: grid; gap: var(--e-2); color: var(--cor-texto-suave); }
  .caixa p { margin: 0; color: var(--cor-texto-suave); }
  .caixa--dica { background: color-mix(in srgb, var(--cor-destaque) 12%, var(--cor-fundo)); border-color: transparent; }
  .caixa--dica h2 :global(.icone) { color: var(--cor-acento); }

  @media print {
    :global(.cabecalho), :global(.rodape), .relacionadas, .receita__acoes, .trilha, .porcoes button, .receita__foto { display: none !important; }
    .receita__topo, .receita__corpo { display: block; }
    .ingredientes { position: static; background: none; padding: 0; margin-bottom: 1.5rem; }
    .receita { padding: 0; }
  }
</style>
