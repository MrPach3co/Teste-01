---
import Base from "../layouts/Base.astro";
---
<Base titulo="Página não encontrada" semIndexar>
  <section class="secao">
    <div class="container cabecalho-secao cabecalho-secao--centro">
      <span class="sobretitulo">Erro 404</span>
      <h1>Essa receita <em>não existe</em>.</h1>
      <p class="lead">A página que você procurou não foi encontrada. Que tal voltar ao início?</p>
      <a href="/" class="btn">Voltar ao início</a>
    </div>
  </section>
</Base>
