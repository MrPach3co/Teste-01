---
// Mostra uma foto da pasta fotos/ otimizada automaticamente (AVIF/WebP em
// vários tamanhos). Se o caminho estiver vazio ou o arquivo não existir,
// mostra um placeholder que deixa claro que a imagem é ilustrativa.
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";
import ImagemPlaceholder from "./ImagemPlaceholder.astro";

interface Props {
  caminho?: string;              // ex.: "receitas/bowl.jpg" (relativo a fotos/)
  alt: string;
  proporcao?: string;            // ex.: "4/3"
  larguras?: number[];
  sizes?: string;
  prioridade?: boolean;          // true para a imagem principal da página
  tom?: "verde" | "pimenta" | "acafrao";
  rotuloPlaceholder?: string;
  tipoPlaceholder?: "prato" | "pessoa" | "maos";
  class?: string;
}

const {
  caminho = "", alt, proporcao = "4/3", larguras = [400, 800, 1200], sizes = "100vw",
  prioridade = false, tom = "verde", rotuloPlaceholder, tipoPlaceholder = "prato", class: classe,
} = Astro.props;

const arquivos = import.meta.glob<{ default: ImageMetadata }>("/fotos/**/*.{jpg,jpeg,png,webp,avif}");
const chave = `/fotos/${caminho.replace(/^\/+|^fotos\//g, "")}`;
const carregar = caminho ? arquivos[chave] : undefined;
const imagem = carregar ? (await carregar()).default : undefined;
if (caminho && !imagem) console.warn(`[foto] não encontrei fotos/${caminho}; usando placeholder.`);
---
{imagem ? (
  <div class:list={["foto", classe]} style={`aspect-ratio:${proporcao}`}>
    <Picture src={imagem} alt={alt} formats={["avif", "webp"]} widths={larguras} sizes={sizes}
      loading={prioridade ? "eager" : "lazy"} fetchpriority={prioridade ? "high" : "auto"} />
  </div>
) : (
  <ImagemPlaceholder rotulo={rotuloPlaceholder ?? alt} proporcao={proporcao} tom={tom} tipo={tipoPlaceholder} class={classe} />
)}

<style>
  .foto { position: relative; overflow: hidden; border-radius: var(--raio-lg); background: var(--cor-fundo-alt); }
  .foto :global(img) { width: 100%; height: 100%; object-fit: cover; }
</style>
