---
import Icone from "../Icone.astro";
import { textos, rico, t } from "../../lib/conteudo";
const p = textos.home.problema;
---
<section class="secao secao--alt" id="problema">
  <div class="container">
    <div class="cabecalho-secao" data-revelar>
      <span class="sobretitulo">{t(p.sobretitulo)}</span>
      <h2 set:html={rico(p.titulo)} />
      <p class="lead">{t(p.intro)}</p>
    </div>
    <div class="grade grade--3">
      {p.itens.map((item: any, i: number) => (
        <article class="problema" data-revelar style={`--atraso:${i * 100}ms`}>
          <span class="problema__icone"><Icone nome={item.icone} tamanho={28} /></span>
          <h3>{t(item.titulo)}</h3>
          <p>{t(item.texto)}</p>
        </article>
      ))}
    </div>
    <p class="problema__conclusao" data-revelar set:html={rico(p.conclusao)} />
  </div>
</section>

<style>
  .problema { padding-top: var(--e-5); border-top: 1px solid var(--cor-texto); }
  .problema__icone {
    display: inline-grid; place-items: center; width: 3.25rem; height: 3.25rem; margin-bottom: var(--e-5);
    border-radius: 50%; background: var(--cor-fundo); color: var(--cor-acento);
  }
  .problema h3 { font-size: var(--t-xl); margin-bottom: var(--e-3); }
  .problema p { color: var(--cor-texto-suave); }
  .problema__conclusao {
    margin: var(--e-8) 0 0; font-family: var(--fonte-titulo); font-size: var(--t-xl); line-height: 1.3; text-align: center;
  }
  .problema__conclusao :global(em) { color: var(--cor-acento); }
</style>
