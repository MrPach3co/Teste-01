---
import Foto from "../Foto.astro";
import Icone from "../Icone.astro";
import { textos, receitas, rico, t, custoPorPorcao } from "../../lib/conteudo";
import { OBJETIVOS, formatarMoeda, formatarTempo } from "../../lib/comum.mjs";

const h = textos.home.hero;
// A composição do hero usa as duas primeiras receitas do acervo
const [principal, secundaria] = receitas;
---
<section class="hero">
  <div class="container hero__grade">
    <div class="hero__texto">
      <span class="sobretitulo hero__anim" style="--i:0">{t(h.sobretitulo)}</span>
      <h1 class="hero__anim" style="--i:1" set:html={rico(h.titulo)} />
      <p class="lead hero__anim" style="--i:2">{t(h.subtitulo)}</p>
      <div class="hero__ctas hero__anim" style="--i:3">
        <a href="/amostra-gratis" class="btn btn--acento btn--grande">{t(h.cta_principal)} <span class="seta" aria-hidden="true">→</span></a>
        <a href="/pre-venda" class="btn btn--contorno btn--grande">{t(h.cta_secundario)}</a>
      </div>
      <ul class="hero__provas hero__anim" style="--i:4">
        {h.provas.map((p: string) => <li><Icone nome="check" tamanho={18} />{t(p)}</li>)}
      </ul>
    </div>

    {principal && (
      <div class="hero__visual" aria-label="Exemplo de receita">
        <div class="hero__foto-principal hero__anim" style="--i:2">
          <Foto caminho={principal.foto} alt={principal.titulo} proporcao="4/5" prioridade
            larguras={[480, 800, 1100]} sizes="(min-width: 1024px) 520px, 90vw" rotuloPlaceholder="" />
        </div>
        {secundaria && (
          <div class="hero__foto-secundaria hero__anim" style="--i:4">
            <Foto caminho={secundaria.foto} alt={secundaria.titulo} proporcao="1/1" tom="pimenta"
              larguras={[300, 500]} sizes="220px" rotuloPlaceholder="" compacto />
          </div>
        )}
        <a href={`/receitas/${principal.slug}`} class="hero__ficha hero__anim" style="--i:5">
          {principal.exemplo && <span class="selo selo--exemplo">Exemplo</span>}
          <strong>{principal.titulo}</strong>
          <span class="hero__ficha-dados">
            <span><Icone nome="relogio" tamanho={16} />{formatarTempo(principal.tempo_preparo_min)}</span>
            <span><Icone nome="moeda" tamanho={16} />{formatarMoeda(custoPorPorcao(principal))}/porção</span>
            <span><Icone nome="alvo" tamanho={16} />{OBJETIVOS[principal.objetivos[0] as keyof typeof OBJETIVOS]}</span>
          </span>
        </a>
      </div>
    )}
  </div>
</section>

<style>
  .hero { padding-block: clamp(2rem, 1rem + 5vw, 5rem) var(--e-secao); overflow: hidden; }
  .hero__grade { display: grid; gap: var(--e-8); align-items: center; }
  .hero h1 { margin-bottom: var(--e-5); }
  .hero .lead { max-width: 34rem; }
  .hero__ctas { display: flex; flex-wrap: wrap; gap: var(--e-3); margin-top: var(--e-6); }
  .hero__provas {
    list-style: none; padding: 0; margin: var(--e-6) 0 0;
    display: flex; flex-wrap: wrap; gap: var(--e-2) var(--e-5);
    font-size: var(--t-sm); color: var(--cor-texto-suave);
  }
  .hero__provas li { display: inline-flex; align-items: center; gap: 0.4em; }
  .hero__provas :global(.icone) { color: var(--cor-primaria); }

  .hero__visual { position: relative; padding: 0 0 var(--e-7) 0; max-width: 34rem; margin-inline: auto; width: 100%; }
  .hero__foto-principal { width: 86%; margin-left: auto; }
  .hero__foto-secundaria {
    position: absolute; left: 0; top: 14%; width: 38%;
    border: 6px solid var(--cor-fundo); border-radius: calc(var(--raio-lg) + 6px); box-shadow: var(--sombra);
  }
  .hero__ficha {
    position: absolute; left: 6%; bottom: 0; right: 8%;
    display: grid; gap: var(--e-2); justify-items: start;
    padding: var(--e-4) var(--e-5);
    background: color-mix(in srgb, var(--cor-fundo) 92%, transparent);
    backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
    border: 1px solid var(--cor-linha); border-radius: var(--raio);
    box-shadow: var(--sombra); text-decoration: none; color: inherit;
    transition: transform var(--transicao);
  }
  .hero__ficha:hover { transform: translateY(-3px); color: inherit; }
  .hero__ficha strong { font-family: var(--fonte-titulo); font-weight: 400; font-size: var(--t-base); line-height: 1.3; }
  .hero__ficha-dados { display: flex; flex-wrap: wrap; gap: var(--e-1) var(--e-4); font-size: var(--t-xs); color: var(--cor-texto-suave); }
  .hero__ficha-dados span { display: inline-flex; align-items: center; gap: 0.35em; }

  @media (min-width: 1024px) {
    .hero__grade { grid-template-columns: 1.25fr 1fr; gap: var(--e-7); }
    .hero__visual { max-width: none; }
  }

  /* Entrada em cascata */
  .hero__anim { animation: subir 900ms cubic-bezier(0.2, 0.7, 0.2, 1) both; animation-delay: calc(var(--i) * 90ms); }
  @keyframes subir { from { opacity: 0; transform: translateY(16px); } }
</style>
