---
import { t } from "../lib/conteudo";
interface Props { itens: { pergunta: string; resposta: string }[] }
const { itens } = Astro.props;
---
<div class="faq">
  {itens.map((item) => (
    <details class="faq__item" data-revelar>
      <summary>
        <span>{t(item.pergunta)}</span>
        <span class="faq__sinal" aria-hidden="true"></span>
      </summary>
      <div class="faq__resposta"><p>{t(item.resposta)}</p></div>
    </details>
  ))}
</div>

<style>
  .faq { border-top: 1px solid var(--cor-linha); }
  .faq__item { border-bottom: 1px solid var(--cor-linha); }
  summary {
    display: flex; justify-content: space-between; align-items: center; gap: var(--e-5);
    padding: var(--e-5) 0; cursor: pointer; list-style: none;
    font-family: var(--fonte-titulo); font-size: var(--t-lg); line-height: 1.3;
  }
  summary::-webkit-details-marker { display: none; }
  summary:hover { color: var(--cor-primaria); }
  .faq__sinal { position: relative; flex: none; width: 1.75rem; height: 1.75rem; border: 1px solid var(--cor-linha); border-radius: 50%; }
  .faq__sinal::before, .faq__sinal::after {
    content: ""; position: absolute; left: 50%; top: 50%; width: 10px; height: 1.5px; background: currentColor;
    transform: translate(-50%, -50%); transition: transform var(--transicao);
  }
  .faq__sinal::after { transform: translate(-50%, -50%) rotate(90deg); }
  details[open] .faq__sinal::after { transform: translate(-50%, -50%) rotate(0deg); }
  .faq__resposta { padding: 0 3rem var(--e-5) 0; color: var(--cor-texto-suave); }
  details[open] .faq__resposta { animation: abrir 260ms ease; }
  @keyframes abrir { from { opacity: 0; transform: translateY(-4px); } }
</style>
