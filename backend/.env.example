# Copie este arquivo para ".env" e preencha os valores reais.
# NUNCA commite o arquivo ".env" (já está no .gitignore).

# Banco de dados. Padrão: SQLite local em dev.
# Em produção, aponte para um Postgres, ex:
# DATABASE_URL=postgresql+psycopg2://usuario:senha@host:5432/kaza_ia
DATABASE_URL=sqlite:///./kaza_ia.db

# Chave secreta usada para assinar os tokens JWT de sessão.
# Gere uma forte com: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=troque-esta-chave-antes-de-ir-para-producao
JWT_ALGORITHM=HS256
JWT_EXPIRA_MINUTOS=60

# Chave da API da Anthropic, usada para interpretar buscas em linguagem
# natural com um modelo Claude de verdade. Se ficar em branco, o backend
# cai automaticamente no motor de regras (sem IA) — a busca continua
# funcionando, só que de forma mais simples.
ANTHROPIC_API_KEY=

# Origens (domínios) autorizadas a chamar a API pelo navegador.
CORS_ORIGENS=http://localhost:8000,http://127.0.0.1:8000
